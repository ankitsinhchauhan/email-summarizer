# Email Summarizer Environment Configuration Example

# Server host and port
HOST=127.0.0.1
PORT=8000

# Telemetry and Timing Logs (1 = enabled, 0 = disabled)
# Timing logs output execution times for request phases without logging document contents
ENABLE_TIMING_LOGS=1

# Allowed CORS Origins (comma-separated list of trusted origins)
# Defaults to localhost dev ports and https://email-summarizer-pi.vercel.app
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://email-summarizer-pi.vercel.app

# Per-process In-Memory Rate Limiting (requests per minute per client IP)
# Defaults to 60 req/min. Set <= 0 to disable.
RATE_LIMIT_PER_MINUTE=60

